# ─────────────────────────────────────────────────────────────────────────────
# AAYKAY website: every setting, with safe example values. NO REAL SECRETS HERE.
#
# WordPress does NOT read .env files. On Hostinger each "runtime" setting below
# is a define() line in public_html/wp-config.php (HOSTINGER_DEPLOYMENT_GUIDE.md §5).
# The "test" settings are shell variables for the test scripts (TESTING_GUIDE.md).
# Copy this file to .env only for local testing (.env is never committed or deployed).
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime: wp-config.php on the server ───────────────────────────────────────
# Secret? | Needed at | Where        | Purpose
# DB_NAME / DB_USER / DB_PASSWORD / DB_HOST
#   secret (password) | runtime | wp-config.php (written by Hostinger's installer) | database connection
DB_NAME=u000000000_aaykay
DB_USER=u000000000_aaykay
DB_PASSWORD=change-me-long-random
DB_HOST=localhost
# AUTH_KEY … NONCE_SALT (8 keys): secret | runtime | wp-config.php (installer) | login cookies and nonces.
# Regenerate at https://api.wordpress.org/secret-key/1.1/salt/ if ever exposed (this logs everyone out).

# not secret | runtime | wp-config.php | 'production' on the live site; the integration
# test refuses to run there. 'local' for the disposable test sites.
WP_ENVIRONMENT_TYPE=production
# not secret | runtime | wp-config.php | false on the live site (never display errors to visitors)
WP_DEBUG=false
# not secret | runtime | wp-config.php | true together with the hPanel cron job (guide §10)
DISABLE_WP_CRON=true
# not secret | runtime | wp-config.php | blocks the theme/plugin code editors in the dashboard
DISALLOW_FILE_EDIT=true

# Enquiry email through a mailbox (inc/enquiry.php). Without these, WordPress uses PHP mail().
# not secret | runtime | wp-config.php
AAYKAY_SMTP_HOST=smtp.hostinger.com
# not secret | runtime | wp-config.php | 465 (SSL) or 587 (STARTTLS)
AAYKAY_SMTP_PORT=465
# not secret | runtime | wp-config.php | optional: ssl | tls | none (none = local mail catcher only)
AAYKAY_SMTP_SECURE=ssl
# not secret | runtime | wp-config.php | the mailbox login, normally its address
AAYKAY_SMTP_USER=website@akepl.in
# SECRET | runtime | wp-config.php only (never Git, never the database)
AAYKAY_SMTP_PASS=change-me
# not secret | runtime | wp-config.php | optional: From address when the login is not an address
AAYKAY_MAIL_FROM=website@akepl.in
# not secret | runtime | wp-config.php | optional: send HSTS (6 months). Only after HTTPS
# works on akepl.in AND www.akepl.in; it cannot be withdrawn early.
AAYKAY_HSTS=false

# ── Runtime: set in the dashboard (stored in the database, not in files) ──────────
# Site settings > Leads > Google Sheets connection (URL, not secret, must start with
#   https://script.google.com/) and Google Sheets secret code (SECRET; created automatically;
#   the same value goes into the Apps Script). Site settings > Search engines >
#   Cloudflare Web Analytics token (not secret; public in the page by design).

# ── Tests: shell variables (local or CI only) ───────────────────────────────────
# not secret | test | your shell / CI | address of the copy of the site under test
BASE_URL=http://localhost:8080
# not secret | test | your shell / CI | WordPress folder of that copy, for WP-CLI checks.
# NEVER set this to a live site: the tests create and delete enquiries.
WP_PATH=/tmp/wp-test
# not secret | test | fresh-site.sh | address WordPress is installed at
WP_URL=http://localhost:8080
# test database for fresh-site.sh, which DROPS and recreates it. Local/CI only.
# (DB_NAME, DB_USER, DB_PASS, DB_HOST — DB_PASS is the test database's password.)
DB_PASS=local-test-only
# not secret | test | fresh-site.sh | WordPress tag to install (default 7.1.4)
WP_VERSION=7.1.4
# not secret | test | playwright | 1 = also Firefox and WebKit (iPhone/iPad sizes)
ALL_BROWSERS=0
# not secret | test | smoke.sh | 1 = also check that search engines are allowed (after launch)
LAUNCHED=0
